  {
    "id": 211, "title": "Math Expressions", "desc": "Type arithmetic and equation strings accurately", "diff": "medium", "lang": "num",
    "parts": [
      { "part": 1,  "title": "Addition",            "text": "1+1=2 2+2=4 3+3=6 4+4=8 5+5=10 6+6=12 7+7=14 8+8=16 9+9=18 10+10=20 15+15=30 25+25=50" },
      { "part": 2,  "title": "Subtraction",         "text": "10-1=9 10-2=8 10-3=7 10-4=6 10-5=5 20-8=12 30-15=15 50-25=25 100-37=63 200-75=125 500-199=301" },
      { "part": 3,  "title": "Multiplication",      "text": "2x2=4 3x3=9 4x4=16 5x5=25 6x6=36 7x7=49 8x8=64 9x9=81 10x10=100 12x12=144 15x4=60 25x4=100" },
      { "part": 4,  "title": "Division",            "text": "10/2=5 20/4=5 30/6=5 100/10=10 50/5=10 72/8=9 81/9=9 144/12=12 225/15=15 1000/25=40 500/20=25" },
      { "part": 5,  "title": "Mixed Ops I",         "text": "2+3=5 10-4=6 3x5=15 20/4=5 7+8=15 15-6=9 4x7=28 36/9=4 9+6=15 25-9=16 8x6=48 56/7=8" },
      { "part": 6,  "title": "Mixed Ops II",        "text": "12+8=20 35-17=18 6x9=54 48/6=8 25+75=100 200-150=50 12x12=144 360/24=15 99+1=100 1000-1=999" },
      { "part": 7,  "title": "Fractions",           "text": "1/2 1/3 1/4 1/5 2/3 3/4 2/5 3/5 4/5 1/8 3/8 5/8 7/8 1/10 3/10 7/10 9/10 1/100 1/1000" },
      { "part": 8,  "title": "Powers & Roots",      "text": "2^2=4 2^3=8 2^4=16 2^5=32 2^6=64 2^7=128 2^8=256 2^9=512 2^10=1024 3^2=9 3^3=27 4^2=16 5^2=25" },
      { "part": 9,  "title": "Long Expressions",    "text": "5+3x2=11 10-2x3=4 100/5+8=28 2^3+4=12 50-10/2=45 3x4+2=14 20/4-1=4 7+3x5=22 9x9-1=80 2^4+16=32" },
      { "part": 10, "title": "Math Mastery",        "text": "2+2=4 10-3=7 5x6=30 48/8=6 2^4=16 1/2+1/4=3/4 100-25%=75 (3+7)x5=50 144/12=12 3^3=27 999+1=1000" }
    ]
  },
