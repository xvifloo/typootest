  {
    "id": 416, "title": "Full HTML Pages", "desc": "Build complete HTML pages from scratch", "diff": "expert", "lang": "html",
    "parts": [
      { "part": 1,  "title": "Minimal HTML page",    "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>Hello</title>\n</head>\n<body>\n  <h1>Hello World!</h1>\n</body>\n</html>" },
      { "part": 2,  "title": "Landing page hero",    "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <meta name='viewport' content='width=device-width'>\n  <title>Landing Page</title>\n  <link rel='stylesheet' href='style.css'>\n</head>\n<body>\n  <header>\n    <nav class='navbar'>\n      <a href='/' class='logo'>Brand</a>\n    </nav>\n  </header>\n  <main>\n    <section class='hero'>\n      <h1>Welcome to Our Site</h1>\n      <p>The best place on the web.</p>\n      <a href='/start' class='btn btn-primary'>Get Started</a>\n    </section>\n  </main>\n</body>\n</html>" },
      { "part": 3,  "title": "Blog post page",       "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <meta name='description' content='Blog post.'>\n  <title>Blog Post</title>\n</head>\n<body>\n  <header>\n    <nav><a href='/'>Home</a> / <a href='/blog'>Blog</a></nav>\n  </header>\n  <main>\n    <article>\n      <h1>Post Title</h1>\n      <time datetime='2026-01-15'>Jan 15, 2026</time>\n      <p>Article content here.</p>\n    </article>\n  </main>\n  <footer><p>&copy; 2026</p></footer>\n</body>\n</html>" },
      { "part": 4,  "title": "Login page",           "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>Login</title>\n</head>\n<body>\n  <main class='auth-wrap'>\n    <div class='auth-card'>\n      <h1>Sign In</h1>\n      <form method='post' action='/login'>\n        <label for='e'>Email</label>\n        <input type='email' id='e' name='email' required>\n        <label for='p'>Password</label>\n        <input type='password' id='p' name='pass' required>\n        <button type='submit'>Login</button>\n      </form>\n      <p>No account? <a href='/signup'>Sign up</a></p>\n    </div>\n  </main>\n</body>\n</html>" },
      { "part": 5,  "title": "404 error page",       "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>404 Not Found</title>\n</head>\n<body>\n  <main class='error-page'>\n    <h1 class='error-code'>404</h1>\n    <h2>Page Not Found</h2>\n    <p>The page you are looking for does not exist.</p>\n    <a href='/' class='btn btn-primary'>Go Home</a>\n  </main>\n</body>\n</html>" },
      { "part": 6,  "title": "Product listing page", "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>Products</title>\n  <link rel='stylesheet' href='style.css'>\n</head>\n<body>\n  <header class='site-header'>\n    <nav class='navbar'>\n      <a href='/'>Home</a>\n      <a href='/products' class='active'>Products</a>\n      <a href='/cart'>Cart (0)</a>\n    </nav>\n  </header>\n  <main>\n    <h1>All Products</h1>\n    <div class='product-grid'>\n      <div class='product-card'>\n        <img src='p1.jpg' alt='Product 1'>\n        <h3>Product One</h3>\n        <p class='price'>$29.99</p>\n        <button class='btn'>Add to Cart</button>\n      </div>\n    </div>\n  </main>\n</body>\n</html>" },
      { "part": 7,  "title": "Dashboard page",       "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>Dashboard</title>\n</head>\n<body class='dashboard'>\n  <aside class='sidebar'>\n    <nav>\n      <a href='/dash'>Overview</a>\n      <a href='/users'>Users</a>\n      <a href='/settings'>Settings</a>\n    </nav>\n  </aside>\n  <main class='dash-main'>\n    <header class='dash-header'>\n      <h1>Dashboard</h1>\n    </header>\n    <section class='stats-grid'>\n      <div class='stat-card'>\n        <span class='stat-num'>1,234</span>\n        <span class='stat-lbl'>Users</span>\n      </div>\n    </section>\n  </main>\n</body>\n</html>" },
      { "part": 8,  "title": "Contact page",         "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <meta name='viewport' content='width=device-width'>\n  <title>Contact Us</title>\n</head>\n<body>\n  <header><nav><a href='/'>Home</a></nav></header>\n  <main>\n    <section class='contact'>\n      <h1>Contact Us</h1>\n      <form class='contact-form' method='post'>\n        <input type='text' name='name' placeholder='Name' required>\n        <input type='email' name='email' placeholder='Email' required>\n        <textarea name='msg' placeholder='Message' rows='5'></textarea>\n        <button type='submit' class='btn'>Send</button>\n      </form>\n    </section>\n  </main>\n  <footer><p>&copy; 2026</p></footer>\n</body>\n</html>" },
      { "part": 9,  "title": "Resume / CV page",     "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <title>Resume - John Doe</title>\n</head>\n<body class='resume'>\n  <header class='resume-header'>\n    <h1>John Doe</h1>\n    <p>Web Developer</p>\n    <p><a href='mailto:john@mail.com'>john@mail.com</a></p>\n  </header>\n  <main>\n    <section>\n      <h2>Experience</h2>\n      <article>\n        <h3>Senior Dev</h3>\n        <p>Company Inc. 2022-2026</p>\n      </article>\n    </section>\n    <section>\n      <h2>Skills</h2>\n      <ul>\n        <li>HTML5</li>\n        <li>CSS3</li>\n        <li>JavaScript</li>\n      </ul>\n    </section>\n  </main>\n</body>\n</html>" },
      { "part": 10, "title": "Grand Master Page",    "text": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='UTF-8'>\n  <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n  <meta name='description' content='My website.'>\n  <title>My Website</title>\n  <link rel='icon' href='favicon.ico'>\n  <link rel='stylesheet' href='style.css'>\n</head>\n<body>\n  <header class='site-header'>\n    <nav class='navbar' aria-label='Main navigation'>\n      <a href='/' class='logo'>Brand</a>\n      <ul class='nav-list'>\n        <li><a href='/about'>About</a></li>\n        <li><a href='/blog'>Blog</a></li>\n        <li><a href='/contact'>Contact</a></li>\n      </ul>\n    </nav>\n  </header>\n  <main id='main-content'>\n    <section class='hero' aria-labelledby='hero-title'>\n      <h1 id='hero-title'>Welcome!</h1>\n      <p>The best website ever made.</p>\n      <a href='/start' class='btn btn-primary'>Get Started</a>\n    </section>\n  </main>\n  <footer class='site-footer'>\n    <p>&copy; 2026 My Brand. All rights reserved.</p>\n  </footer>\n  <script src='app.js'></script>\n</body>\n</html>" }
