  {
    "id": 414, "title": "Inline Styles & script", "desc": "Add style attributes and script tags to HTML", "diff": "medium", "lang": "html",
    "parts": [
      { "part": 1,  "title": "Inline color",         "text": "<p style='color: red;'>Red text</p>" },
      { "part": 2,  "title": "Inline background",    "text": "<div style='background: #007bff; color: white; padding: 10px;'>\n  Blue box\n</div>" },
      { "part": 3,  "title": "Inline flex",          "text": "<div style='display: flex; gap: 16px; align-items: center;'>\n  <span>Left</span>\n  <span>Right</span>\n</div>" },
      { "part": 4,  "title": "Style tag",            "text": "<style>\n  body {\n    margin: 0;\n    font-family: sans-serif;\n  }\n</style>" },
      { "part": 5,  "title": "Style with selector",  "text": "<style>\n  .card {\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    padding: 16px;\n  }\n</style>" },
      { "part": 6,  "title": "Inline hidden",        "text": "<div style='display: none;' id='modal'>\n  Modal content\n</div>" },
      { "part": 7,  "title": "Script at bottom",     "text": "<body>\n  <h1>Hello</h1>\n  <script src='app.js'></script>\n</body>" },
      { "part": 8,  "title": "Inline script",        "text": "<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    console.log('Page loaded');\n  });\n</script>" },
      { "part": 9,  "title": "Script with type",     "text": "<script type='module' src='main.js'></script>\n<script type='module'>\n  import { fn } from './utils.js';\n  fn();\n</script>" },
      { "part": 10, "title": "Head with style+script","text": "<head>\n  <meta charset='UTF-8'>\n  <title>Page</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; }\n  </style>\n</head>\n<body>\n  <div id='app'></div>\n  <script src='app.js'></script>\n</body>" }
    ]
