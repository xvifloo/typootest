  {
    "id": 413, "title": "Meta & Head Tags", "desc": "Write complete head sections with meta tags", "diff": "medium", "lang": "html",
    "parts": [
      { "part": 1,  "title": "charset meta",         "text": "<meta charset='UTF-8'>" },
      { "part": 2,  "title": "viewport meta",        "text": "<meta name='viewport' content='width=device-width, initial-scale=1.0'>" },
      { "part": 3,  "title": "description meta",     "text": "<meta name='description' content='A great website for learning HTML.'>" },
      { "part": 4,  "title": "author meta",          "text": "<meta name='author' content='John Doe'>\n<meta name='keywords' content='HTML, CSS, web'>" },
      { "part": 5,  "title": "Open Graph tags",      "text": "<meta property='og:title' content='My Page'>\n<meta property='og:type' content='website'>\n<meta property='og:url' content='https://site.com'>" },
      { "part": 6,  "title": "Twitter card",         "text": "<meta name='twitter:card' content='summary'>\n<meta name='twitter:title' content='My Page'>\n<meta name='twitter:description' content='A great page.'>" },
      { "part": 7,  "title": "CSS link tag",         "text": "<link rel='stylesheet' href='style.css'>\n<link rel='stylesheet' href='mobile.css' media='(max-width: 768px)'>" },
      { "part": 8,  "title": "Favicon link",         "text": "<link rel='icon' type='image/png' href='favicon.png'>\n<link rel='apple-touch-icon' href='icon-180.png'>" },
      { "part": 9,  "title": "Preload resource",     "text": "<link rel='preload' href='font.woff2' as='font' type='font/woff2' crossorigin>\n<link rel='preconnect' href='https://fonts.googleapis.com'>" },
      { "part": 10, "title": "Full head section",    "text": "<head>\n  <meta charset='UTF-8'>\n  <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n  <meta name='description' content='My website.'>\n  <title>My Website</title>\n  <link rel='icon' href='favicon.ico'>\n  <link rel='stylesheet' href='style.css'>\n  <meta property='og:title' content='My Website'>\n</head>" }
    ]
