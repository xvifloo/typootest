  {
    "id": 415, "title": "UI Components", "desc": "Build real-world HTML components", "diff": "hard", "lang": "html",
    "parts": [
      { "part": 1,  "title": "Button group",         "text": "<div class='btn-group'>\n  <button class='btn btn-primary'>Save</button>\n  <button class='btn btn-secondary'>Cancel</button>\n  <button class='btn btn-danger'>Delete</button>\n</div>" },
      { "part": 2,  "title": "Alert box",            "text": "<div class='alert alert-success' role='alert'>\n  <strong>Success!</strong> Your data has been saved.\n  <button class='close' aria-label='Close'>&times;</button>\n</div>" },
      { "part": 3,  "title": "Badge and tag",        "text": "<span class='badge badge-primary'>New</span>\n<span class='badge badge-success'>Active</span>\n<span class='tag'>HTML</span>\n<span class='tag'>CSS</span>" },
      { "part": 4,  "title": "Breadcrumb nav",       "text": "<nav aria-label='breadcrumb'>\n  <ol class='breadcrumb'>\n    <li class='bc-item'><a href='/'>Home</a></li>\n    <li class='bc-item'><a href='/blog'>Blog</a></li>\n    <li class='bc-item active'>Post Title</li>\n  </ol>\n</nav>" },
      { "part": 5,  "title": "Tabs component",       "text": "<div class='tabs'>\n  <div class='tab-list'>\n    <button class='tab active' data-tab='1'>Tab 1</button>\n    <button class='tab' data-tab='2'>Tab 2</button>\n    <button class='tab' data-tab='3'>Tab 3</button>\n  </div>\n  <div class='tab-content' id='tab-1'>Content 1</div>\n  <div class='tab-content hidden' id='tab-2'>Content 2</div>\n</div>" },
      { "part": 6,  "title": "Dropdown menu",        "text": "<div class='dropdown'>\n  <button class='btn dropdown-toggle'>Menu</button>\n  <ul class='dropdown-menu'>\n    <li><a href='/profile'>Profile</a></li>\n    <li><a href='/settings'>Settings</a></li>\n    <li><hr class='divider'></li>\n    <li><a href='/logout'>Logout</a></li>\n  </ul>\n</div>" },
      { "part": 7,  "title": "Modal dialog",         "text": "<div class='modal' id='myModal' role='dialog' aria-modal='true'>\n  <div class='modal-box'>\n    <div class='modal-header'>\n      <h3>Confirm Action</h3>\n      <button class='close'>&times;</button>\n    </div>\n    <div class='modal-body'>\n      <p>Are you sure?</p>\n    </div>\n    <div class='modal-footer'>\n      <button class='btn btn-primary'>Yes</button>\n      <button class='btn btn-secondary'>No</button>\n    </div>\n  </div>\n</div>" },
      { "part": 8,  "title": "Search form",          "text": "<form class='search-form' role='search'>\n  <label for='search' class='sr-only'>Search</label>\n  <div class='input-group'>\n    <input type='search'\n           id='search'\n           class='form-input'\n           placeholder='Search...'\n           autocomplete='off'>\n    <button type='submit' class='btn btn-primary'>\n      Search\n    </button>\n  </div>\n</form>" },
      { "part": 9,  "title": "Profile card",         "text": "<div class='profile-card'>\n  <img src='avatar.jpg' alt='User' class='avatar'>\n  <div class='profile-info'>\n    <h3 class='profile-name'>John Doe</h3>\n    <p class='profile-role'>Developer</p>\n    <div class='profile-stats'>\n      <span>Posts: <strong>42</strong></span>\n      <span>Likes: <strong>128</strong></span>\n    </div>\n  </div>\n  <a href='/profile' class='btn btn-sm'>View Profile</a>\n</div>" },
      { "part": 10, "title": "Notification bell",    "text": "<div class='notify-wrap'>\n  <button class='btn-icon' aria-label='Notifications'>\n    <svg width='20' height='20' aria-hidden='true'>\n      <use href='#icon-bell'></use>\n    </svg>\n    <span class='badge badge-dot' aria-label='3 unread'>3</span>\n  </button>\n  <div class='notify-dropdown hidden'>\n    <h4 class='notify-title'>Notifications</h4>\n    <ul class='notify-list'>\n      <li class='notify-item unread'>New message</li>\n      <li class='notify-item'>Comment reply</li>\n    </ul>\n  </div>\n</div>" }
    ]
